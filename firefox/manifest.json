{
  "manifest_version": 3,
  "name": "Joplin Clipper Plus",
  "version": "0.55.0",
  "description": "Evernote-style web clipper for Joplin: simplified article, full page, selection, and bookmark capture.",
  "browser_specific_settings": {
    "gecko": {
      "id": "joplin-clipper-plus@iamtalker.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "scripts": ["core.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
